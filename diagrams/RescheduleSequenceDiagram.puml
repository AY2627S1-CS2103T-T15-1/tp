@startuml
!include style.puml
skinparam ArrowFontStyle plain

box Logic LOGIC_COLOR_T1
participant ":LogicManager" as LogicManager LOGIC_COLOR
participant "c:RescheduleAppointmentCommand" as RescheduleCommand LOGIC_COLOR
participant "s:PersonSelector" as PersonSelector LOGIC_COLOR
participant "r:CommandResult" as CommandResult LOGIC_COLOR
end box

box Model MODEL_COLOR_T1
participant "m:Model" as Model MODEL_COLOR
participant "ab:AddressBook" as AddressBook MODEL_COLOR
participant "p:Person" as Person MODEL_COLOR
participant "a:Appointment" as Appointment MODEL_COLOR
participant "u:Person" as UpdatedPerson MODEL_COLOR
end box

[-> LogicManager : execute("appointment ~--reschedule\n~--id 2 ~--index 1 ~--date 2026-12-08 ~--time 18:00")
activate LogicManager

ref over LogicManager, RescheduleCommand, PersonSelector
    parse the command into c, which holds s
    (see the Logic component section)
end ref

LogicManager -> RescheduleCommand : execute(m)
activate RescheduleCommand

RescheduleCommand -> Model : getAddressBook()
activate Model

Model --> RescheduleCommand : ab
deactivate Model

RescheduleCommand -> AddressBook : getPersonList()
activate AddressBook

AddressBook --> RescheduleCommand : clients
deactivate AddressBook

RescheduleCommand -> PersonSelector : findMatches(clients)
activate PersonSelector

PersonSelector --> RescheduleCommand : matches
deactivate PersonSelector

note right of RescheduleCommand
    with ~--id, matches holds
    exactly one client p
end note

RescheduleCommand -> RescheduleCommand : executeOn(p, m)
activate RescheduleCommand

note right of RescheduleCommand
    checks the index and the date
    (failures not shown)
end note

create Appointment
RescheduleCommand -> Appointment : Appointment(2026-12-08, 18:00)
activate Appointment

Appointment --> RescheduleCommand : a
deactivate Appointment

note right of RescheduleCommand
    checks a against the client's other
    appointments (failure not shown)
end note

RescheduleCommand -> Person : withAppointments(list with a)
activate Person

create UpdatedPerson
Person -> UpdatedPerson
activate UpdatedPerson

UpdatedPerson --> Person
deactivate UpdatedPerson

Person --> RescheduleCommand : u
deactivate Person

RescheduleCommand -> Model : setPerson(p, u)
activate Model

Model --> RescheduleCommand
deactivate Model

RescheduleCommand -> Model : updateFilteredPersonList(all clients)
activate Model

Model --> RescheduleCommand
deactivate Model

create CommandResult
RescheduleCommand -> CommandResult
activate CommandResult

CommandResult --> RescheduleCommand
deactivate CommandResult

RescheduleCommand --> RescheduleCommand : r
deactivate RescheduleCommand

RescheduleCommand --> LogicManager : r
deactivate RescheduleCommand

LogicManager -> LogicManager : saveAddressBook()

[<--LogicManager
deactivate LogicManager
@enduml
