<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<HBox id="cardPane" fx:id="cardPane" alignment="TOP_LEFT" spacing="14" minHeight="96"
      xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1">
  <padding>
    <Insets top="16" right="24" bottom="16" left="16" />
  </padding>
  <VBox spacing="5" HBox.hgrow="ALWAYS" minWidth="0">
    <Label fx:id="name" styleClass="contact-name" maxWidth="Infinity" />
    <Label fx:id="phone" styleClass="contact-phone" maxWidth="Infinity" />
  </VBox>
  <Label fx:id="id" styleClass="contact-index">
    <minWidth>
      <Region fx:constant="USE_PREF_SIZE" />
    </minWidth>
  </Label>
</HBox>
