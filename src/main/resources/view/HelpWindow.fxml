<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.Scene?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.stage.Stage?>

<fx:root title="Cindy Help" type="javafx.stage.Stage" resizable="true" minWidth="480" minHeight="420"
         xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1">
  <icons>
    <Image url="@/images/help_icon.png" />
  </icons>
  <scene>
    <Scene width="820" height="720">
      <stylesheets>
        <URL value="@HelpWindow.css" />
      </stylesheets>
      <VBox styleClass="help-shell" spacing="16" minWidth="0">
        <padding>
          <Insets top="20" right="20" bottom="20" left="20" />
        </padding>
        <VBox fx:id="helpMessageContainer" spacing="10" minHeight="-Infinity">
          <Label text="Cindy Help" styleClass="help-title" />
          <HBox alignment="CENTER_LEFT" spacing="16" minWidth="0">
            <Label fx:id="helpMessage" wrapText="true" minWidth="0" maxWidth="Infinity"
                   minHeight="-Infinity" HBox.hgrow="ALWAYS" />
            <Button fx:id="copyButton" mnemonicParsing="false" onAction="#copyUrl" text="Copy URL"
                    minWidth="-Infinity" />
          </HBox>
        </VBox>
        <ScrollPane fx:id="commandScroll" fitToWidth="true" hbarPolicy="NEVER" minWidth="0" minHeight="0"
                    VBox.vgrow="ALWAYS">
          <content>
            <VBox spacing="12" minWidth="0">
              <padding>
                <Insets right="12" />
              </padding>
              <VBox spacing="8" styleClass="help-guidance" minWidth="0" minHeight="-Infinity">
                <Label text="Command reference" styleClass="help-section-title" />
                <Label wrapText="true" minWidth="0" minHeight="-Infinity"
                       text="Replace UPPERCASE placeholders with your values. [Brackets] mark optional parts. Choose one alternative separated by |; do not type the brackets or parentheses." />
                <Label wrapText="true" minWidth="0" minHeight="-Infinity"
                       text="ID means the client's persistent ID, not their position in the list. Name selectors match part of a name, ignoring case. If several clients match, choose one using --id." />
              </VBox>
              <VBox fx:id="commandSummaries" spacing="12" minWidth="0" minHeight="-Infinity" />
              <Label fx:id="keyboardShortcuts" styleClass="help-shortcuts" wrapText="true" minWidth="0"
                     minHeight="-Infinity"
                     text="Keyboard shortcuts: F1 opens help from the main window. In the command box, Up / Down recalls previous commands; Enter executes the command." />
            </VBox>
          </content>
        </ScrollPane>
      </VBox>
    </Scene>
  </scene>
</fx:root>
