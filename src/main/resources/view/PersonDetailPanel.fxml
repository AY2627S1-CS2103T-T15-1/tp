<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<ScrollPane fx:id="sessionScrollPane" styleClass="contact-list, client-detail-scroll" fitToWidth="true" hbarPolicy="NEVER" minWidth="0"
            xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1">
  <content>
    <VBox spacing="16" minWidth="0">
      <VBox styleClass="client-detail-card">
        <StackPane fx:id="personHeader" minHeight="96" />
        <VBox fx:id="noteSection" spacing="4" visible="false" managed="false">
          <padding>
            <Insets top="0" right="24" bottom="16" left="16" />
          </padding>
          <Label text="Note" styleClass="client-note-heading" />
          <Label fx:id="note" styleClass="client-note" wrapText="true" />
        </VBox>
      </VBox>
      <VBox styleClass="client-detail-card, session-section" spacing="12">
        <padding>
          <Insets top="20" right="24" bottom="24" left="16" />
        </padding>
        <Label text="Recent sessions" styleClass="session-section-title" />
        <VBox fx:id="sessionList" spacing="8" />
      </VBox>
      <VBox fx:id="workoutPlanCard" styleClass="client-detail-card" spacing="10" minWidth="0"
            visible="false" managed="false">
        <padding>
          <Insets top="20" right="24" bottom="24" left="16" />
        </padding>
        <Label text="Workout plan" styleClass="contact-name" />
        <Label fx:id="workoutPlanText" styleClass="contact-phone, workout-plan-text" wrapText="true"
               minWidth="0" maxWidth="Infinity" minHeight="-Infinity" />
      </VBox>
      <VBox fx:id="appointmentsCard" styleClass="client-detail-card" spacing="10" minWidth="0"
            visible="false" managed="false">
        <padding>
          <Insets top="20" right="24" bottom="24" left="16" />
        </padding>
        <Label text="Appointments" styleClass="contact-name" />
        <Label fx:id="appointmentsText" styleClass="contact-phone, workout-plan-text" wrapText="true"
               minWidth="0" maxWidth="Infinity" minHeight="-Infinity" />
      </VBox>
    </VBox>
  </content>
</ScrollPane>
