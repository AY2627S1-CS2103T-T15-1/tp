<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<ScrollPane styleClass="contact-list, client-detail-scroll" fitToWidth="true" hbarPolicy="NEVER" minWidth="0"
            xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1">
  <content>
    <VBox spacing="16" minWidth="0">
      <StackPane fx:id="personHeader" styleClass="client-detail-card" minHeight="96" />
      <VBox fx:id="workoutPlanCard" styleClass="client-detail-card" spacing="10" minWidth="0"
            visible="false" managed="false">
        <padding>
          <Insets top="20" right="24" bottom="24" left="16" />
        </padding>
        <Label text="Workout plan" styleClass="contact-name" />
        <Label fx:id="workoutPlanText" styleClass="contact-phone, workout-plan-text" wrapText="true"
               minWidth="0" maxWidth="Infinity" minHeight="-Infinity" />
      </VBox>
    </VBox>
  </content>
</ScrollPane>
