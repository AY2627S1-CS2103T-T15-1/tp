<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<VBox styleClass="contact-list, client-detail-card" minHeight="96" prefHeight="300" maxHeight="-Infinity"
      xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1">
  <StackPane fx:id="personHeader" />
  <VBox fx:id="noteSection" spacing="4">
    <padding>
      <Insets top="0" right="24" bottom="16" left="16" />
    </padding>
    <Label text="Note" styleClass="client-note-heading" />
    <Label fx:id="note" styleClass="client-note" wrapText="true" />
  </VBox>
</VBox>
