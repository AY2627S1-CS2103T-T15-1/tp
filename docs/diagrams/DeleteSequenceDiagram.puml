@startuml
!include style.puml
skinparam ArrowFontStyle plain
skinparam DefaultFontSize 16
skinparam ParticipantPadding 4
skinparam Participant {
    Padding 0
    FontSize 16
}

participant ":LogicManager" as Logic LOGIC_COLOR
participant "d:DeleteCommand" as Command LOGIC_COLOR
participant "s:PersonSelector" as Selector LOGIC_COLOR
participant "m:Model" as Model MODEL_COLOR

[-> Logic : execute(commandText)
activate Logic
ref over Logic, Command
    Parse command into d holding s
    (Delete parsing diagram)
end ref
Logic -> Command : execute(m)
activate Command
Command -> Model : get all clients
activate Model
Model --> Command : clients
deactivate Model
note right of Model
    getAddressBook()
    .getPersonList()
end note
Command -> Selector : findMatches(clients)
activate Selector
Selector --> Command : matches
deactivate Selector

alt exactly one client p matches
    Command -> Command : executeOn(p, m)
    activate Command
    Command -> Model : deletePerson(p)
    activate Model
    Model --> Command
    deactivate Model
    Command --> Command : r
    deactivate Command
else several clients match (name selector)
    Command -> Model : updateFilteredPersonList(...)
    activate Model
    Model --> Command
    deactivate Model
    note over Command, Model
        No client is deleted.
        r lists matches and asks for an ID.
    end note
end

note over Command
    r is a new CommandResult
    (creation omitted).
end note
Command --> Logic : r
deactivate Command
Logic -> Logic : saveAddressBook()
[<-- Logic : r
deactivate Logic
@enduml
