@startuml
!include style.puml
skinparam ArrowFontStyle plain

box Logic LOGIC_COLOR_T1
participant ":LogicManager" as LogicManager LOGIC_COLOR
participant ":AddressBookParser" as AddressBookParser LOGIC_COLOR
participant ":DeleteCommandParser" as DeleteCommandParser LOGIC_COLOR
participant "<<class>>\nParserUtil" as ParserUtil LOGIC_COLOR
participant "s:PersonSelector" as PersonSelector LOGIC_COLOR
participant "d:DeleteCommand" as DeleteCommand LOGIC_COLOR
participant "r:CommandResult" as CommandResult LOGIC_COLOR
end box

box Model MODEL_COLOR_T1
participant "m:Model" as Model MODEL_COLOR
end box

[-> LogicManager : execute("delete --id 1")
activate LogicManager

LogicManager -> AddressBookParser : parseCommand("delete --id 1")
activate AddressBookParser

create DeleteCommandParser
AddressBookParser -> DeleteCommandParser
activate DeleteCommandParser

DeleteCommandParser --> AddressBookParser
deactivate DeleteCommandParser

AddressBookParser -> DeleteCommandParser : parse("--id 1")
activate DeleteCommandParser

DeleteCommandParser -> ParserUtil : parsePersonSelector(...)
activate ParserUtil

create PersonSelector
ParserUtil -> PersonSelector
activate PersonSelector

PersonSelector --> ParserUtil
deactivate PersonSelector

ParserUtil --> DeleteCommandParser : s
deactivate ParserUtil

create DeleteCommand
DeleteCommandParser -> DeleteCommand : DeleteCommand(s)
activate DeleteCommand

DeleteCommand --> DeleteCommandParser
deactivate DeleteCommand

DeleteCommandParser --> AddressBookParser : d
deactivate DeleteCommandParser
'Hidden arrow to position the destroy marker below the end of the activation bar.
DeleteCommandParser -[hidden]-> AddressBookParser
destroy DeleteCommandParser

AddressBookParser --> LogicManager : d
deactivate AddressBookParser

LogicManager -> DeleteCommand : execute(m)
activate DeleteCommand

DeleteCommand -> Model : getAddressBook().getPersonList()
activate Model

Model --> DeleteCommand : clients
deactivate Model

DeleteCommand -> PersonSelector : findMatches(clients)
activate PersonSelector

PersonSelector --> DeleteCommand : matches
deactivate PersonSelector

alt no client matches

    note right of DeleteCommand
        A CommandException is thrown
        and no client is deleted.
    end note

else exactly one client p matches

    DeleteCommand -> DeleteCommand : executeOn(p, m)
    activate DeleteCommand

    DeleteCommand -> Model : deletePerson(p)
    activate Model

    Model --> DeleteCommand
    deactivate Model

    create CommandResult
    DeleteCommand -> CommandResult
    activate CommandResult

    CommandResult --> DeleteCommand
    deactivate CommandResult

    DeleteCommand --> DeleteCommand : r
    deactivate DeleteCommand

else several clients match (only possible with --name)

    DeleteCommand -> Model : updateFilteredPersonList(...)
    activate Model

    Model --> DeleteCommand
    deactivate Model

    create CommandResult
    DeleteCommand -> CommandResult
    activate CommandResult

    CommandResult --> DeleteCommand
    deactivate CommandResult

    note right of DeleteCommand
        r lists the matching clients
        and asks the user to choose
        one with --id. No client is deleted.
    end note

end

DeleteCommand --> LogicManager : r
deactivate DeleteCommand

[<--LogicManager
deactivate LogicManager
@enduml
