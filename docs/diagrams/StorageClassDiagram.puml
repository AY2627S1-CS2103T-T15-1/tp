@startuml
!include style.puml
skinparam arrowThickness 1.1
skinparam arrowColor STORAGE_COLOR
skinparam classBackgroundColor STORAGE_COLOR
skinparam packageStyle Folder

package Storage as StoragePackage {

interface Storage <<interface>>
Class StorageManager

Class JsonUserPrefsStorage
Class JsonAddressBookStorage
Class JsonSerializableAddressBook
Class JsonAdaptedPerson
Class JsonAdaptedTag
Class JsonAdaptedSession
Class JsonAdaptedAppointment
}

StorageManager .up.|> Storage
StorageManager -down-> "1" JsonUserPrefsStorage
StorageManager -down-> "1" JsonAddressBookStorage

JsonAddressBookStorage ..> JsonSerializableAddressBook
' Constructors retain supplied adapter objects, which can be shared.
' In particular, JsonAdaptedPerson.withId reuses tags, sessions and appointments.
' These are associations rather than exclusive composition relationships.
JsonSerializableAddressBook --> "0..*" JsonAdaptedPerson : persons
JsonSerializableAddressBook --> "0..*" JsonAdaptedTag : groups
JsonAdaptedPerson -right-> "0..*" JsonAdaptedTag : tags
JsonAdaptedPerson --> "0..*" JsonAdaptedSession : sessions
JsonAdaptedPerson --> "0..*" JsonAdaptedAppointment : appointments

@enduml
