@startuml
!include style.puml
skinparam arrowThickness 1.1
skinparam arrowColor LOGIC_COLOR_T4
skinparam classBackgroundColor LOGIC_COLOR

package Logic as LogicPackage {

package "Parser Classes" as ParserClasses{
}
Class AddCommand
Class FindCommand
Class DeleteCommand
Class ViewCommand
Class "{abstract}\nPersonTargetedCommand" as PersonTargetedCommand
Class PersonSelector
Class CommandResult
Class "{abstract}\nCommand" as Command


Class "<<interface>>\nLogic" as Logic
Class LogicManager
}

package Model as ModelPackage {
Class "<<interface>>\nModel" as Model MODEL_COLOR
Class Person MODEL_COLOR
Class PersonId MODEL_COLOR
}

package Storage as StoragePackage {
Class "<<interface>>\nStorage" as Storage STORAGE_COLOR
}

Class HiddenOutside #FFFFFF
HiddenOutside ..> Logic

LogicManager .up.|> Logic
LogicManager -left->"1" ParserClasses
ParserClasses ..> AddCommand : <<create>>
ParserClasses ..> DeleteCommand : <<create>>
ParserClasses ..> PersonSelector : <<create>>
' Show representative creation dependencies; FindCommand and ViewCommand are also parser-created.

AddCommand -up-|> Command
FindCommand -up-|> Command
PersonTargetedCommand -up-|> Command
DeleteCommand -up-|> PersonTargetedCommand
ViewCommand -up-|> PersonTargetedCommand
PersonTargetedCommand --> "1" PersonSelector
LogicManager .down.> Command : <<call>>

LogicManager --> Model
LogicManager --> Storage
Command .right.> Model
PersonSelector ..> Person
PersonSelector --> "0..1\nid" PersonId
' Only representative concrete commands are shown.

Logic ..> CommandResult
LogicManager .down.> CommandResult
Command .right.> CommandResult : <<create>>
CommandResult --> "0..1\npersonToView" Person

legend bottom
Only representative commands and creation dependencies are shown.
endlegend
@enduml
